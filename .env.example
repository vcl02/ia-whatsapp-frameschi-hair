# NÃO coloque valores reais aqui. Estes nomes vão para os secrets do Supabase,
# nunca para o repositório. Prefixo SALAO_ para não colidir com os secrets do
# hub enquanto o bot estiver hospedado lá (secrets valem para o projeto todo).
SALAO_WHATSAPP_VERIFY_TOKEN=     # texto aleatório que você inventa e repete no painel da Meta
SALAO_META_APP_SECRET=           # App Secret do app na Meta (valida X-Hub-Signature-256)
SALAO_WHATSAPP_TOKEN=            # token permanente de usuário do sistema
SALAO_WHATSAPP_PHONE_NUMBER_ID=  # ID do número (não é o telefone)
SALAO_GRAPH_API_VERSION=         # ex.: v00.0 — usar a versão mostrada no painel da Meta
SALAO_ANTHROPIC_API_KEY=         # chave própria do bot (separa custo do hub)
SALAO_PAINEL_ORIGEM=             # origem da tela para CORS, ex.: http://localhost:8000
SALAO_MA_FIREBASE_KEY=           # chave pública do Firebase do Minha Agenda (consulta de horários). Vazio = desligado
SALAO_AGENDAR=                   # "nao" desliga o agendamento pelo bot (a consulta continua)
SALAO_SO_RESPONDER_PARA=         # LEGADO: só vale se a tabela salao_numeros não existir. A lista de teste/familiares agora é editada no painel
SALAO_AVISO_EMAIL_PARA=          # e-mails que recebem o aviso "precisa de você", separados por vírgula
SALAO_AVISO_EMAIL_DE=            # remetente aceito pelo Resend (domínio verificado lá)
SALAO_RESEND_API_KEY=            # chave do Resend (provedor de e-mail)
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já existem nas Edge Functions hospedadas.
